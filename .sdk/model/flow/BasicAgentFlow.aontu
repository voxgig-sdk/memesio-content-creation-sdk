# BasicAgentFlow

main: kit: flow: BasicAgentFlow:
{
  entity: "agent",
  kind: "basic",
  name: "BasicAgentFlow",
  step: [
    {
      i: {
        ref: "agent_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "agent_ref01",
        srcdatavar: "agent_ref01_data",
        suffix: "_up0",
        textfield: "description"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "agent_ref01",
        srcdatavar: "agent_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-agent_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAgentFlow"
}