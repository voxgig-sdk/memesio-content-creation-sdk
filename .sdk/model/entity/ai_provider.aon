# Entity: ai_provider

main: kit: entity: ai_provider: {

  alias: field: {}

  fields: [
    {
      name: "actorId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "correlationId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "limit"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "mappingMode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "maxSlots"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "prompt"
      req: true
      type: "`$STRING`"
    }
    {
      name: "sourceImageUrl"
      req: true
      type: "`$STRING`"
    }
    {
      name: "texts"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "trendSignals"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "workspaceId"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "ai_provider"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/ai/templates/detect"
          parts: [
            "api"
            "ai"
            "templates"
            "detect"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/api/ai/templates/suggest"
          parts: [
            "api"
            "ai"
            "templates"
            "suggest"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "refresh"
                orig: "refresh"
                reqd: false
                type: "`$BOOLEAN`"
              }
            ]
          }
          method: "GET"
          orig: "/api/ai/providers/background-remove-benchmark"
          parts: [
            "api"
            "ai"
            "providers"
            "background-remove-benchmark"
          ]
          select: {
            exist: [
              "refresh"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "refresh"
                orig: "refresh"
                reqd: false
                type: "`$BOOLEAN`"
              }
            ]
          }
          method: "GET"
          orig: "/api/ai/providers/face-swap-benchmark"
          parts: [
            "api"
            "ai"
            "providers"
            "face-swap-benchmark"
          ]
          select: {
            exist: [
              "refresh"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/api/ai/memes/generate"
          parts: [
            "api"
            "ai"
            "memes"
            "generate"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
