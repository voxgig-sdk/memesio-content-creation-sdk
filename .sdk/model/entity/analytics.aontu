            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/api/analytics/dashboards/activation-retention"
          parts: [
            "api"
            "analytics"
            "dashboards"
            "activation-retention"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
