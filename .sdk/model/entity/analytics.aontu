# Entity: analytics

main: kit: entity: analytics: {

  alias: field: {}

  name: "analytics"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "template_id"
                orig: "template_id"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/analytics/experiments/templates"
          parts: [
            "api"
            "analytics"
            "experiments"
            "templates"
          ]
          select: {
            exist: [
              "template_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "window_hour"
                orig: "window_hour"
                reqd: false
