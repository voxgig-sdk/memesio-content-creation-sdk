# Entity: meme

main: kit: entity: meme: {

  alias: field: {}

  fields: [
    {
      name: "alt_text"
      req: true
      type: "`$STRING`"
    }
    {
      name: "canonical_image_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "canva"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "caption"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "created_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "image_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "nsfw_status"
      req: true
      type: "`$STRING`"
    }
    {
      name: "overlay"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "share_slug"
      req: true
      type: "`$STRING`"
    }
    {
      name: "share_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "share_view"
