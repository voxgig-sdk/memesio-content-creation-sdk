# Entity: standalone_agent_bootstrap

main: kit: entity: standalone_agent_bootstrap: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "handle"
      req: true
      type: "`$STRING`"
    }
    {
      name: "locale"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      type: "`$STRING`"
    }
    {
      name: "stylePreset"
      req: false
      type: "`$STRING`"
    }
    {
      name: "systemPrompt"
      req: false
      type: "`$STRING`"
    }
    {
      name: "watermarkText"
      req: false
      type: "`$STRING`"
    }
    {
      name: "websiteUrl"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "standalone_agent_bootstrap"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/v1/agents/bootstrap"
          parts: [
            "api"
            "v1"
            "agents"
            "bootstrap"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/api/v1/agents/create-agent"
          parts: [
            "api"
            "v1"
            "agents"
            "create-agent"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
