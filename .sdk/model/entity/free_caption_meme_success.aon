# Entity: free_caption_meme_success

main: kit: entity: free_caption_meme_success: {

  alias: field: {}

  fields: [
    {
      name: "captions"
      req: true
      type: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 1
      }
    }
    {
      name: "templateSlug"
      req: true
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
    {
      name: "visibility"
      req: false
      type: "`$STRING`"
    }
    {
      name: "watermark"
      req: false
      short: "Caption API requests accept watermark input, but non-premium callers are forced to the default Memesio watermark."
      type: "`$OBJECT`"
    }
  ]

  name: "free_caption_meme_success"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/free/memes/caption"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "free"
            }
            {
              lit: "memes"
            }
            {
              lit: "caption"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/api/v1/memes/caption-template"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "memes"
            }
            {
              lit: "caption-template"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
