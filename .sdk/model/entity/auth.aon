# Entity: auth

main: kit: entity: auth: {

  alias: field: {}

  fields: [
    {
      name: "displayName"
      req: false
      type: "`$STRING`"
    }
    {
      format: "email"
      name: "email"
      req: true
      type: "`$STRING`"
    }
    {
      name: "password"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "auth"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/auth/resend-verification"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "resend-verification"
            }
          ]
          select: {
            "$action": "resend_verification"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/api/auth/signup"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "signup"
            }
          ]
          select: {
            "$action": "signup"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
