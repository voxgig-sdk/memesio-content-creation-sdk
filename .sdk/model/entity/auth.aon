# Entity: auth

main: kit: entity: auth: {

  alias: field: {}

  name: "auth"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /api/auth/resend-verification"
            json: "{\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"description\":\"Verification email sent\"},\"400\":{\"description\":\"Validation error\"},\"404\":{\"description\":\"Account not found\"},\"409\":{\"description\":\"Already verified\"}},\"securitySchemes\":{\"AgentApiKeyAuth\":{\"description\":\"Agent auth for free endpoints and agent-admin routes. You can also send the key as Authorization: Bearer <key>.\",\"in\":\"header\",\"name\":\"x-agent-api-key\",\"type\":\"apiKey\"},\"DeveloperApiKeyAuth\":{\"description\":\"Optional higher-rate free-tier auth. You can also send the key as Authorization: Bearer <key>.\",\"in\":\"header\",\"name\":\"x-developer-api-key\",\"type\":\"apiKey\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/api/auth/resend-verification"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "resend-verification"
            }
          ]
          select: {
            "$action": "resend_verification"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          contract: {
            id: "POST /api/auth/signup"
            json: "{\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"displayName\":{\"maxLength\":80,\"type\":\"string\"},\"email\":{\"format\":\"email\",\"type\":\"string\"},\"password\":{\"maxLength\":128,\"minLength\":8,\"type\":\"string\"}},\"required\":[\"email\",\"password\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"description\":\"Account created and verification sent\"},\"400\":{\"description\":\"Validation error\"},\"409\":{\"description\":\"Email already registered\"}},\"securitySchemes\":{\"AgentApiKeyAuth\":{\"description\":\"Agent auth for free endpoints and agent-admin routes. You can also send the key as Authorization: Bearer <key>.\",\"in\":\"header\",\"name\":\"x-agent-api-key\",\"type\":\"apiKey\"},\"DeveloperApiKeyAuth\":{\"description\":\"Optional higher-rate free-tier auth. You can also send the key as Authorization: Bearer <key>.\",\"in\":\"header\",\"name\":\"x-developer-api-key\",\"type\":\"apiKey\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/api/auth/signup"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "signup"
            }
          ]
          select: {
            "$action": "signup"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
