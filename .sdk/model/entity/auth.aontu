# Entity: auth

main: kit: entity: auth: {

  alias: field: {}

  fields: [
    {
      name: "display_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "email"
      req: true
      type: "`$STRING`"
    }
    {
      name: "password"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "auth"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/auth/resend-verification"
          parts: [
            "api"
            "auth"
            "resend-verification"
          ]
          select: {
            "$action": "resend_verification"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/api/auth/signup"
          parts: [
            "api"
            "auth"
            "signup"
          ]
          select: {
            "$action": "signup"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
