              }
              {
                kind: "query"
                name: "surface"
                orig: "surface"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/growth/experiments/decision"
          parts: [
            "api"
            "growth"
            "experiments"
            "decision"
          ]
          select: {
            exist: [
              "actor_id"
              "log_exposure"
              "surface"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
