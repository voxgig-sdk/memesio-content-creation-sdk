  ]

  name: "growth"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/growth/experiments/decision"
          parts: [
            "api"
            "growth"
            "experiments"
            "decision"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/api/growth/lifecycle-messaging"
          parts: [
            "api"
            "growth"
            "lifecycle-messaging"
          ]
          select: {
            "$action": "lifecycle_messaging"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
