              "limit"
              "published_only"
              "week_start"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "actor_id"
                orig: "actor_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "publish_limit"
                orig: "publish_limit"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/growth/social-publish"
          parts: [
            "api"
            "growth"
            "social-publish"
          ]
          select: {
            "$action": "social_publish"
            exist: [
              "actor_id"
              "publish_limit"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "actor_id"
                orig: "actor_id"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/growth/referrals"
