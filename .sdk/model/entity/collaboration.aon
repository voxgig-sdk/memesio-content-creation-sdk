# Entity: collaboration

main: kit: entity: collaboration: {

  alias: field: {}

  fields: [
    {
      name: "authorId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "message"
      req: true
      type: "`$STRING`"
    }
    {
      name: "projectId"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "collaboration"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/collab/comments"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "collab"
            }
            {
              lit: "comments"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "project_id"
                orig: "project_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/collab/comments"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "collab"
            }
            {
              lit: "comments"
            }
          ]
          select: {
            exist: [
              "page"
              "page_size"
              "project_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
